PYANNOTE_API_KEY=sk_75aefa6018374be1a8da8f9507a84f83
AUDO_API_KEY=3619359c35881712da48ed7b2831ebd5

TMP_DIR=./tmp
MAX_FILE_SIZE_MB=200

# --- Denoising ---
FULL_AUDIO_DENOISE_PASSES=1
SPLIT_AUDIO_DENOISE_PASSES=2

# --- Overlap suppression (cross-speaker guard) ---
DROP_OVERLAP_AUDIO=true
OVERLAP_GUARD_MS=400                    # was 500 — fallback guard, real overlaps now caught by confidence
CONFIDENCE_AWARE_OVERLAP_DROP=true
OVERLAP_CONFIDENCE_THRESHOLD=65        # was 75 — more turns treated as high-confidence
HIGH_CONFIDENCE_OVERLAP_GUARD_MS=80    # was 120 — tighter guard for confident turns
SEGMENT_EDGE_TRIM_MS=150               # was 120 — trim a bit more off raw segment edges

# --- Low-confidence turn dropping ---
DROP_LOW_CONFIDENCE_TURNS=false
MIN_TURN_CONFIDENCE_TO_KEEP=65
MIN_CLEAN_SEGMENT_MS=120

# --- Sample-level confidence blocking (new) ---
USE_SAMPLE_CONFIDENCE=true             # request per-sample confidence array from pyannoteAI
SAMPLE_CONFIDENCE_THRESHOLD=40.0       # samples below this score are blocked from all speakers
SEGMENT_FADE_MS=50                     # ms of fade-in/out applied at every audio chunk edge (50ms = industry standard)